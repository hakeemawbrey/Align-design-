# Meta app (developers.facebook.com) using "Instagram API with Facebook Login"
META_APP_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v26.0
# Facebook Login for Business > Configurations: the configuration ID (it holds the permission list).
# Leave empty to request permissions with the classic scope list instead.
META_LOGIN_CONFIG_ID=

# Public URL of this app. Add ${APP_URL}/api/auth/meta/callback as a valid OAuth redirect URI in the Meta app.
APP_URL=http://localhost:3000

# Password for the app's own sign-in screen. Required: the app stores your Instagram token.
APP_PASSWORD=

# Optional: protects GET /api/cron for an external scheduler (send header "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Optional: key for the Claude API (/api/agent). Claude uses it through `npm run agent`, which reads it from .env.
# Leave empty to turn the API off. Generate one with: openssl rand -hex 32
AGENT_API_KEY=

# Most likes the engagement queue will send per day (each one is still a click by you).
DAILY_LIKE_CAP=30

# SQLite file location
DATABASE_PATH=./data/studio.db
