{
  "name": "align-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Download every post on an Instagram page (or every reel and video on a Facebook page, a whole YouTube channel, or an X account), transcribe and read it on your own computer, and pack it up for Claude to analyze",
  "engines": { "node": ">=21" },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "scripts": {
    "download": "node src/download.mjs",
    "facebook": "node src/facebook.mjs",
    "youtube": "node src/youtube.mjs",
    "twitter": "node src/twitter.mjs",
    "tiktok": "node src/tiktok.mjs",
    "quick": "node src/quick.mjs",
    "numbers": "node src/numbers.mjs",
    "process": "node src/process.mjs",
    "report": "node src/report.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
