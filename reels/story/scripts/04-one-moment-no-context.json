  },
  "shots": [
    { "say": "In this town, on your eighteenth birthday, you're shown one single moment from your future love life.", "at": "plaza", "sky": "day",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "shock", "anim": "idle", "over": "card", "glow": true, "hat": "party" }],
      "props": [{ "kind": "cake", "x": 0, "z": 1.6 }], "fx": ["confetti"], "cam": { "on": "maya", "view": "close", "yaw": 0 } },
    { "say": "But there's one strange rule. You never get any context.", "at": "plaza", "sky": "day",
      "cast": [{ "id": "bff", "x": 0, "z": 0, "face": "shock", "anim": "shrug" }],
      "fx": ["board:NO CONTEXT"], "cam": { "on": "bff", "view": "medium", "yaw": 0 } },
    { "say": "One Leo saw himself down on one knee, so he proposed on the first date.", "at": "cafe", "sky": "day",
      "cast": [{ "id": "leo", "x": -1.1, "z": 0, "face": "love", "anim": "kneel", "hold": "card", "ry": 60 },
               { "id": "date", "x": 1.3, "z": 0, "face": "shock", "anim": "idle", "ry": -60 }],
      "cam": { "at": [0, 2.2, 0], "view": "medium", "yaw": 0 } },
    { "say": "She said no. In the picture, he was tying his shoe.", "at": "cafe", "sky": "day",
      "cast": [{ "id": "leo", "x": 0, "z": 0, "face": "sad", "anim": "tie" }],
      "grade": "gray", "cam": { "on": "leo", "view": "medium", "yaw": 15 } },
    { "say": "And one Cancer saw herself crying, alone in the plaza, at eleven eleven, in the rain.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "cry", "anim": "cry" }],
      "fx": ["rain"], "grade": "gray", "cam": { "on": "maya", "view": "medium", "yaw": 0, "push": 0.15 } },
    { "say": "Her name was Maya.", "at": "room", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "neutral", "anim": "wave" }],
      "cam": { "on": "maya", "view": "close", "yaw": 0 } },
    { "say": "The whole town decided Maya's love life was doomed.", "at": "plaza", "sky": "dusk",
      "cast": [{ "id": "maya", "x": 0, "z": 3, "face": "sad", "anim": "slump", "ry": 180 }],
      "crowd": { "n": 14, "radius": 6, "anim": "point" },
      "cam": { "at": [0, 3.5, -1], "view": "wide", "yaw": 0, "height": 5 } },
    { "say": "So Maya decided it too. Every time someone aligned on her, she released them first.", "at": "plaza", "sky": "dusk",
      "cast": [{ "id": "maya", "x": -1.2, "z": 0, "face": "angry", "anim": "shrug", "ry": 55, "over": "card" },
               { "id": "sol", "x": 1.4, "z": 0, "face": "sad", "anim": "walkoff", "ry": 90, "over": "card" }],
      "cam": { "at": [0, 2.6, 0], "view": "medium", "yaw": 0 } },
    { "say": "Until one night, her best friend dragged her to the plaza, at eleven eleven.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "bff", "x": -0.8, "z": 0, "face": "happy", "anim": "point", "ry": 30 },
               { "id": "maya", "x": 0.9, "z": 0.4, "face": "focus", "anim": "slump", "ry": -20 }],
      "cam": { "at": [0, 2.4, 0], "view": "medium", "yaw": 0 } },
    { "say": "And it started to rain.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "shock", "anim": "idle" }],
      "fx": ["rain"], "cam": { "on": "maya", "view": "close", "yaw": 0 } },
    { "say": "Maya froze. This was the moment.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "sad", "anim": "shake" }],
      "fx": ["rain", "question:maya"], "cam": { "on": "maya", "view": "medium", "yaw": 0, "push": 0.2 } },
    { "say": "Then, across the plaza, a card started to glow. A Pisces named Sol had aligned on her.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "sol", "x": 0, "z": 0, "face": "soft", "anim": "idle", "over": "card", "glow": true }],
      "fx": ["rain", "sparkle:sol"], "cam": { "on": "sol", "view": "medium", "yaw": 0, "lookUp": 1 } },
    { "say": "And for once, Maya aligned back.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "soft", "anim": "idle", "over": "card", "glow": true }],
      "fx": ["rain"], "cam": { "on": "maya", "view": "close", "yaw": 0 } },
    { "say": "Both cards flipped, and Maya burst into tears. Exactly like the picture.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": 0, "z": 0, "face": "cry", "anim": "cry", "over": "card", "flipAt": 0.1, "glow": true }],
      "fx": ["rain"], "cam": { "on": "maya", "view": "medium", "yaw": 0, "lookUp": 0.8 } },
    { "say": "Turns out the picture was never the end of the story. It was three seconds before he ran over with an umbrella.", "at": "plaza", "sky": "night",
      "cast": [{ "id": "maya", "x": -0.7, "z": 0, "face": "love", "anim": "idle", "over": "card", "flipped": true, "ry": 20 },
               { "id": "sol", "x": 0.75, "z": 0, "face": "love", "anim": "umbrella", "over": "card", "flipped": true, "ry": -20 }],
      "fx": ["rain", "hearts:maya"], "cam": { "at": [0, 2.8, 0], "view": "medium", "yaw": 0 } },
    { "say": "Align. It's not the moment. It's who you align with after it.", "at": "plaza", "sky": "night", "end": true,
      "cast": [{ "id": "maya", "x": -0.7, "z": 0, "face": "happy", "anim": "idle", "over": "card", "flipped": true, "ry": 20 },
               { "id": "sol", "x": 0.75, "z": 0, "face": "happy", "anim": "umbrella", "over": "card", "flipped": true, "ry": -20 }],
      "fx": ["rain"], "cam": { "at": [0, 4, -4], "view": "wide", "yaw": 0, "height": 5 } }
  ],
  "end": "align",
  "endSub": "it's who you align with after"
}
