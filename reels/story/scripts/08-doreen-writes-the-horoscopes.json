      "fx": ["hearts:june"], "cam": { "at": [0, 2.4, 0], "view": "medium", "yaw": 10 } },
    { "say": "Until one night, Theo finally snapped.", "at": "room", "sky": "night",
      "cast": [{ "id": "theo", "x": 0, "z": 0, "face": "angry", "anim": "snap" }],
      "fx": ["rings:theo"], "cam": { "on": "theo", "view": "medium", "yaw": 0 } },
