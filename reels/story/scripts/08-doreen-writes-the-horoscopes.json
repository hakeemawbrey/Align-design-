      "cast": [{ "id": "doreen", "x": 0, "z": -1, "face": "soft", "anim": "talk" }],
      "fx": ["bubble:doreen:i don't know anything about virgos. you never leave the house."], "cam": { "on": "doreen", "view": "close", "yaw": -8 } },
    { "say": "So Doreen read Theo's whole chart. His Venus was in Leo. He was never supposed to stay inside. He was supposed to make a scene.", "at": "room", "sky": "night",
