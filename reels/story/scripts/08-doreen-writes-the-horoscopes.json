      "fx": ["board:SCORPIO|Let go of the past."], "cam": { "on": "scorp", "view": "medium", "yaw": 0 } },
    { "say": "But for eight years, Doreen wrote the exact same thing for Virgos.", "at": "room", "sky": "night",
