      "fx": ["bubble:theo:why do you hate virgos?"], "cam": { "on": "theo", "view": "close", "yaw": 180 } },
    { "say": "Doreen looked at him for a very long time.", "at": "street", "sky": "night", "hold": 0.4,
      "cast": [{ "id": "doreen", "x": 0, "z": -1, "face": "focus", "anim": "idle" }],
      "cam": { "on": "doreen", "view": "close", "yaw": 0, "push": 0.25 } },
