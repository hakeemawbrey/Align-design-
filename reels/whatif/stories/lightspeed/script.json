{
  "id": "lightspeed",
  "title": "What if \"I love you\" had a speed limit?",
  "voice": "bm_george",
  "speed": 1.0,
  "gap": 0.24,
  "lines": [
    {"text": "What if \"I love you\" had a speed limit?", "beats": {"limit": "limit"}},
    {"text": "It does. Nothing moves faster than light.", "beats": {"light": "light"}},
    {"text": "It could circle the Earth seven times in one second.", "beats": {"circle": "circle", "seven": "seven"}},
    {"text": "So across a room, it arrives before you've finished smiling.", "beats": {"room": "room", "smiling": "smiling"}},
    {"text": "But if they were on the Moon, it would take over a second.", "beats": {"Moon": "moon", "second": "second"}},
    {"text": "On Mars, up to twenty-two minutes.", "beats": {"Mars": "mars", "minutes": "minutes"}},
    {"text": "Long enough to wonder if they heard you at all.", "beats": {"wonder": "wonder"}},
    {"text": "At the nearest star, four years.", "beats": {"star": "star", "years": "years"}},
    {"text": "Say it on a first date, and the reply arrives on your eighth anniversary.", "beats": {"date": "date", "anniversary": "anniversary"}},
    {"text": "Across the galaxy, all of recorded history would fit inside the silence.", "beats": {"galaxy": "galaxy", "silence": "silence"}, "gapAfter": 0.36},
    {"text": "Distance is really just time. Time you don't get back.", "beats": {"time": "time", "back": "rewind"}},
    {"text": "But right here, it's instant.", "beats": {"here": "here", "instant": "instant"}},
    {"text": "So don't make it wait.", "beats": {"wait": "title"}}
  ],
