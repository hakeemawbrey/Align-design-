  },
  "scenes": [
    { "text": "This is why your first date never met the *real you.*", "set": "cafe", "shot": "push", "focus": "both",
      "cast": [{ "who": "you", "mark": "seatL", "pose": "sit", "expr": "smug" }, { "who": "them", "mark": "seatR", "pose": "sit", "expr": "smitten" }], "sfx": "whoosh" },
    { "text": "You were born at *7:42* in the morning.", "set": "room", "shot": "snap", "focus": "clock",
      "cast": [], "fx": ["clock"], "sfx": "tick" },
    { "text": "At that exact minute, one sign was rising in the east.", "set": "space", "shot": "low", "focus": "horizon",
      "cast": [], "fx": ["rise:capricorn"], "tag": "your rising sign", "sfx": "swell" },
    { "text": "That's your *rising sign.* It changes about every two hours.", "set": "space", "shot": "orbit", "focus": "you",
      "cast": [{ "who": "you", "mark": "center", "pose": "float", "expr": "shock" }], "fx": ["wheel", "glyph:capricorn"], "sfx": "whoosh" },
    { "text": "It's how you come across when you meet someone new.", "set": "street", "shot": "medium", "focus": "you",
      "cast": [{ "who": "you", "mark": "center", "pose": "wave", "expr": "smile" }], "fx": ["glyph:capricorn"], "sfx": "pop" },
    { "text": "Capricorn rising, so on the date you were calm and put together.", "set": "cafe", "shot": "medium", "focus": "you",
      "cast": [{ "who": "you", "mark": "seatL", "pose": "sit", "expr": "smug" }, { "who": "them", "mark": "seatR", "pose": "sit", "expr": "smitten" }], "fx": ["sparks"], "sfx": "ding" },
    { "text": "But you're a *Pisces* sun. At home you cry at dog videos.", "set": "room", "shot": "medium", "focus": "you",
      "cast": [{ "who": "you", "mark": "bed", "pose": "phone", "expr": "sad" }], "fx": ["tears", "glyph:pisces"], "sfx": "boing" },
    { "text": "They fell for the Capricorn. Then they met the Pisces.", "set": "room", "shot": "snap", "focus": "them",
      "cast": [{ "who": "you", "mark": "bed", "pose": "phone", "expr": "sad" }, { "who": "them", "mark": "door", "pose": "shock", "expr": "shock", "look": "you" }], "fx": ["exclaim"], "sfx": "thud" },
    { "text": "Your rising gets you the date. Your sun and moon decide if it lasts.", "set": "space", "shot": "wide", "focus": "you",
      "cast": [{ "who": "you", "mark": "center", "pose": "float", "expr": "smile" }], "fx": ["planet:sun", "planet:moon"], "sfx": "whoosh" },
    { "text": "So say the honest thing early.", "set": "space", "shot": "pull", "focus": "both",
      "cast": [{ "who": "you", "mark": "left", "pose": "float", "expr": "smile" }, { "who": "them", "mark": "right", "pose": "float", "expr": "smile" }], "fx": ["link"], "sfx": "swell" }
  ],
  "end": "say the honest thing"
}
