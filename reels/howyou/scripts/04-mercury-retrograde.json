{
  "id": "04-mercury-retrograde",
  "title": "How Mercury retrograde ruined your text",
  "caption": "mercury didn't send it. but it was watching",
  "cta": "comment RETRO and we'll send you the dates for the next one",
  "hashtags": ["mercuryretrograde", "astrology", "mercury", "texting", "zodiac"],
  "cast": {
    "you": { "skin": "#a8704c", "shirt": "#3fae8c", "pants": "#2b2e4a", "hair": "#140d0a", "style": "curly", "sign": "gemini" },
    "them": { "skin": "#f2c8a6", "shirt": "#c64a5c", "pants": "#2f2f3f", "hair": "#5a3418", "style": "long", "sign": "scorpio" }
  },
  "scenes": [
    { "text": "This is how *Mercury retrograde* ruined your text.", "set": "room", "shot": "push", "focus": "you",
      "cast": [{ "who": "you", "mark": "bed", "pose": "phone", "expr": "smile" }], "sfx": "whoosh" },
    { "text": "A few times a year, Mercury looks like it's moving *backwards.*", "set": "space", "shot": "orbit", "focus": "center",
      "cast": [], "fx": ["planet:mercury", "retro"], "tag": "mercury retrograde", "sfx": "rewind" },
    { "text": "It isn't. Earth is just passing it, like a car on the highway.", "set": "space", "shot": "top", "focus": "center",
      "cast": [], "fx": ["orbits"], "sfx": "whoosh" },
    { "text": "But Mercury rules talking and texting. So astrologers say, be careful.", "set": "space", "shot": "medium", "focus": "you",
      "cast": [{ "who": "you", "mark": "center", "pose": "phone", "expr": "worried" }], "fx": ["planet:mercury"], "sfx": "pop" },
    { "text": "You type, *I miss you.*", "set": "phone", "shot": "phone",
      "screen": { "name": "Sam", "msgs": [["them", "see you saturday"], ["me", "I miss you"]] }, "sfx": "pop" },
    { "text": "You send it to the wrong person. Your *ex.*", "set": "phone", "shot": "phone",
      "screen": { "name": "do not text", "msgs": [["them", "please stop"], ["me", "I miss you"]] }, "sfx": "thud" },
    { "text": "They reply in four seconds.", "set": "room", "shot": "snap", "focus": "you",
      "cast": [{ "who": "you", "mark": "bed", "pose": "shock", "expr": "shock" }], "fx": ["exclaim", "sweat"], "sfx": "boing" },
    { "text": "Retrograde didn't make you do it. It's just a good time to reread.", "set": "street", "shot": "medium", "focus": "you",
      "cast": [{ "who": "you", "mark": "center", "pose": "think", "expr": "worried" }], "fx": ["retro"], "sfx": "whoosh" },
    { "text": "And say what you mean, to the right person.", "set": "space", "shot": "pull", "focus": "both",
      "cast": [{ "who": "you", "mark": "left", "pose": "float", "expr": "smile" }, { "who": "them", "mark": "right", "pose": "float", "expr": "smile" }], "fx": ["link"], "sfx": "swell" }
  ],
  "end": "say the honest thing"
}
